# Copy to .env for local dev. NEVER commit the real .env.

# Postgres connection string. Railway provides this automatically as a
# reference variable (${{ Postgres.DATABASE_URL }}).
DATABASE_URL=postgresql://user:password@localhost:5432/mobility

# Signing key for JWTs. MUST be >= 32 chars and kept secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# How long issued tokens stay valid.
JWT_EXPIRES_IN=30d

# Comma-separated extra allowed origins (e.g. the Railway-hosted web build).
# Capacitor + localhost origins are always allowed.
CORS_ORIGINS=https://your-web-build.up.railway.app

# Railway sets PORT automatically; default is 8080 for local dev.
PORT=8080
NODE_ENV=development
