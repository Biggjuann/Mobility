# Base URL of the Mobility backend API (Railway deployment).
# Leave empty for local-only / offline PWA builds.
VITE_API_URL=https://your-app.up.railway.app

# RevenueCat public iOS SDK key (Project settings → API keys → Public app-specific
# for Apple). Safe to ship; not a secret. Required for in-app subscriptions.
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx

# Local dev only: set to true to unlock all Pro content in the browser preview.
# VITE_FORCE_PRO=true
